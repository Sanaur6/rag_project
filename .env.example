# Browser UI accounts. Use different credentials for the admin account.
APP_USERNAME=employee
APP_PASSWORD=replace-with-a-strong-password
DOCS_ADMIN_USERNAME=admin
DOCS_ADMIN_PASSWORD=replace-with-a-different-strong-password

# API bearer token.
APP_ACCESS_TOKEN=replace-with-a-long-random-api-token

# Optional: enables Gemini answers and semantic embeddings.
GEMINI_API_KEY=

# Optional: defaults to data/documents.
DOCS_FOLDER=data/documents

# Optional: defaults to data/assistant.sqlite3.
APP_DATABASE_PATH=data/assistant.sqlite3

# Set true when the app is served over HTTPS.
APP_COOKIE_SECURE=false
